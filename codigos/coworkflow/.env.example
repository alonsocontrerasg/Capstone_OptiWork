# ============================================================
# CoworkFlow — plantilla de variables de entorno
# Copiar a .env.local (git-ignored) y completar los valores.
#   cp .env.example .env.local
# NUNCA versionar .env.local ni pegar secretos en issues/PRs.
# ============================================================

# --- Supabase -------------------------------------------------
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Segura para el navegador: solo permite lo que dicten las políticas RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...anon
# ¡SECRETO! Ignora RLS por completo. Solo uso servidor:
# scripts locales (simulación/seeds) y tareas administrativas.
# Nunca con prefijo NEXT_PUBLIC_ ni importada desde un Client Component.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role

# --- URL pública de la app ------------------------------------
# Se usa para armar el redirect del magic link y las URLs de los QR.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Tokens de QR rotativo ------------------------------------
# Clave HMAC-SHA256 en hexadecimal: EXACTAMENTE 64 caracteres hex (256 bits). Generar con:
#   openssl rand -hex 32
# Debe ser idéntica a la fila `qr_token_secret` de public.app_secrets (la RPC verifica la
# firma en Postgres). `src/lib/env.server.ts` valida el formato al arrancar.
# Rotarla invalida todos los QR emitidos (máx. 2 ventanas de gracia): rótala también en
# app_secrets o todos los escaneos fallarán con token_expirado.
QR_TOKEN_SECRET=cambiar-por-64-caracteres-hex-generados-aleatoriamente
# Duración de cada ventana del QR, en segundos (30-60 recomendado).
# El servidor acepta la ventana actual y la anterior.
QR_WINDOW_SECONDS=45

# --- Zona por defecto -----------------------------------------
# Slug de la zona que se muestra cuando la URL no trae ?zona=
NEXT_PUBLIC_ZONA_POR_DEFECTO=hub-providencia

# --- Rate limiting (Upstash Redis, plan gratuito) -------------
# Se usa en /api/scan y /auth/login (no en /api/qr/token: ese endpoint solo firma).
# Si se dejan vacías, en desarrollo se usa un almacén en memoria con advertencia en consola.
# En producción son OBLIGATORIAS (serverless no comparte memoria): si faltan, el
# endpoint falla cerrado (ver credencialesUpstash() en src/lib/env.server.ts).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
